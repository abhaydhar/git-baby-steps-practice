{
  "mcpServers": {
    "interview": {
      "type": "stdio",
      "command": "codemie-mcp-proxy",
      "args": [
        "https://mcp.epam.com/mcp/interview"
      ],
      "env": {}
    },
    "echo-windows": {
      "type": "stdio",
      "command": "powershell",
      "args": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "./path/to/mcp-echo.ps1"
      ]
    }
  }
}